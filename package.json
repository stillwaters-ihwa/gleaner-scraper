{
  "name": "gleaner",
  "description": "Point-and-click web scraper in your browser's side panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "node scripts/copy-assets.mjs && wxt prepare",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "e2e": "node e2e/run-all.mjs",
    "package": "wxt build && node scripts/make-installer.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "@mozilla/readability": "0.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-virtual": "3.14.20",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "mux.js": "^6.3.0",
    "papaparse": "5.7.0",
    "pdfjs-dist": "^4.10.38",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "^6.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/auto-icons": "1.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "ffprobe-static": "^3.1.0",
    "happy-dom": "^18.0.1",
    "playwright": "^1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.2.7",
    "wxt": "0.21.4"
  }
}
